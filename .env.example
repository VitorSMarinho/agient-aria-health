# Copie este arquivo para .env e preencha com suas chaves
GROQ_API_KEY=sua_chave_groq_aqui

# Opcionais — sem elas o ARIA cai automaticamente pra dado de demonstração
# e vector store local (data/vector_store.json). Ver supabase/01-knowledge-base-pgvector.sql
# pro schema que precisa existir no Supabase antes de configurar essas duas.
SUPABASE_URL=sua_url_supabase_aqui
SUPABASE_KEY=sua_chave_supabase_aqui

# Ajustes finos do agente (todos têm default razoável, raramente precisa mexer)
# ARIA_LLM_MODEL=openai/gpt-oss-120b
# ARIA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# ARIA_MAX_TOOL_ITERATIONS=4
# ARIA_TOP_K=4
# ARIA_TRACES_PATH=logs/aria_traces.jsonl